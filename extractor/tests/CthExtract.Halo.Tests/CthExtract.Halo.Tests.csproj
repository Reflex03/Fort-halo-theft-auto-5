<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CthExtract.Halo.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS0618;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- test-only Vorbis decoder (MIT) used as an oracle for the FSB remux -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CthExtract.Halo/CthExtract.Halo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="oracle/rmf_oracle.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
