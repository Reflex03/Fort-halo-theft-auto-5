<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CthExtract.Cli.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CthExtract/CthExtract.csproj" />
    <!-- ModuleIntegrationTests reuse the modules' own synthetic installs (SyntheticHalo, SynthGame): built by our code, no game data -->
    <ProjectReference Include="../CthExtract.Halo.Tests/CthExtract.Halo.Tests.csproj" />
    <ProjectReference Include="../CthExtract.Gta.Tests/CthExtract.Gta.Tests.csproj" />
    <!-- RealCliEndToEndTests: fake game folders + the CONTRACTS.md cache check (tests/CthExtract.E2E, also used by tests/e2e.sh) -->
    <ProjectReference Include="../CthExtract.E2E/CthExtract.E2E.csproj" />
  </ItemGroup>
</Project>
