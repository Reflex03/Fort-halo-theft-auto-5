<Project>
  <!-- CthExtract: replaces upstream's Directory.Build.props for the vendored projects (no packing/SourceLink).
       Upstream warnings are not ours to fix; they are hidden so the extractor build output stays readable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.2.2</Version>
    <InformationalVersion>1.2.2+1e3293d4-cthextract.1</InformationalVersion>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>FabianFG</Authors>
    <Copyright>Copyright (c) 2026 FabianFG</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);CS0108;CS0109;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0420;CS0612;CS0618;CS0649;CS0659;CS0660;CS0661;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1998;CS4014;CS8073;CS8321;CS8500;CS9107;CS9113;CS9124;CS9191;CS9192;CS9193;CS9195;CA1416;CA2014;CA2022;SYSLIB0050;SYSLIB0051;NU1903;NU1902;NU1901;CS8597;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8607;CS8608;CS8609;CS8610;CS8611;CS8612;CS8613;CS8614;CS8615;CS8616;CS8617;CS8618;CS8619;CS8620;CS8621;CS8622;CS8624;CS8625;CS8629;CS8631;CS8632;CS8633;CS8634;CS8643;CS8644;CS8645;CS8655;CS8667;CS8669;CS8670;CS8714;CS8762;CS8763;CS8764;CS8765;CS8766;CS8767;CS8768;CS8769;CS8770;CS8774;CS8775;CS8776;CS8777;CS8819;CS8824;CS8825;CS8847</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
</Project>
