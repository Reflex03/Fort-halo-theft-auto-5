<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendored from https://github.com/FabianFG/CUE4Parse @ 1e3293d4 (Apache-2.0), stripped and patched for
       CthExtract: see ../VENDORED.md. Detex.dll, crunch.dll and tegra_swizzle_x64.dll are not embedded. -->
  <PropertyGroup>
    <RootNamespace>CUE4Parse_Conversion</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>CUE4Parse Conversion</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetRipper.TextureDecoder" />
    <PackageReference Include="SharpGLTF.Core" />
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- managed SkiaSharp only: TextureDecoder.Decode -> CTexture never touches Skia, so libSkiaSharp is not shipped -->
    <PackageReference Include="SkiaSharp" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CUE4Parse\CUE4Parse.csproj" />
  </ItemGroup>

</Project>
