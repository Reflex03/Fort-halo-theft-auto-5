{
  "sheet": "weapons",
  "doc": "Halo 3 weapons. Models, textures and sounds come from the player's own MCC install (sources sheet). Stats here are Halo 3 defaults in Halo damage points; the extractor overwrites damage/rate/clip from the weapon's own tags when it can read them (stats.json in the cache). 1 Halo point = haloToMc hearts-half-points (systems.combat).",
  "columns": {
    "id":              {"type": "string", "required": true},
    "name":            {"type": "string", "required": true},
    "kind":            {"type": "enum", "values": ["hitscan", "projectile", "rocket", "grenade"], "required": true},
    "damage":          {"type": "number", "required": true, "doc": "Halo points per bullet/pellet/impact"},
    "pellets":         {"type": "int", "required": true},
    "burst":           {"type": "int", "required": true, "doc": "rounds per trigger pull"},
    "fireIntervalTicks": {"type": "int", "required": true},
    "auto":            {"type": "bool", "required": true},
    "clip":            {"type": "int", "required": true},
    "reserve":         {"type": "int", "required": true},
    "reloadTicks":     {"type": "int", "required": true},
    "spreadDeg":       {"type": "number", "required": true},
    "range":           {"type": "number", "required": true, "doc": "blocks"},
    "projectileSpeed": {"type": "number", "required": true, "doc": "blocks/tick; 0 for hitscan"},
    "homing":          {"type": "bool", "required": true},
    "blastRadius":     {"type": "number", "required": true},
    "zoom":            {"type": "number", "required": true, "doc": "FOV multiplier when using (1 = none)"},
    "model":           {"type": "ref", "ref": "sources.id", "required": true},
    "fireSound":       {"type": "ref", "ref": "sources.id", "required": true},
    "rarity":          {"type": "enum", "values": ["common", "uncommon", "rare", "epic", "legendary"], "required": true}
  },
